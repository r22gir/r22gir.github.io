  <script type="__bundler/template">
"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"three\": \"https://unpkg.com/three@0.184.0/build/three.module.js\",\n    \"three/addons/controls/OrbitControls.js\": \"https://unpkg.com/three@0.184.0/examples/jsm/controls/OrbitControls.js\",\n    \"three/addons/exporters/OBJExporter.js\": \"https://unpkg.com/three@0.184.0/examples/jsm/exporters/OBJExporter.js\",\n    \"three/addons/exporters/GLTFExporter.js\": \"https://unpkg.com/three@0.184.0/examples/jsm/exporters/GLTFExporter.js\"\n  },\n  \"integrity\": {\n    \"https://unpkg.com/three@0.184.0/build/three.module.js\": \"sha384-8FCZ1eVO6it4+pbec2aDtnTrwjWXZLJRC+MAGCIPDgsYnUrl/E0A2YlF8ioMKI/J\",\n    \"https://unpkg.com/three@0.184.0/build/three.core.js\": \"sha384-dw2ooPewaEIrAgl6oFDBmmBWCE9oW9LxRGcfwZ0hLvEprzo202wXl7vCYHRlSnOT\",\n    \"https://unpkg.com/three@0.184.0/examples/jsm/controls/OrbitControls.js\": \"sha384-4rziNxOBZKQ69i+w+f89KJ55TCYquwchVbByQwmaOeIOXdOU2PLDn3kOfXHwIJC9\",\n    \"https://unpkg.com/three@0.184.0/examples/jsm/exporters/OBJExporter.js\": \"sha384-nbwtoZENJD3Vq+ACK0CuGQdPMuDWHkamC2KJD70EV5nfg6jQjfppKOea07YJN+N3\",\n    \"https://unpkg.com/three@0.184.0/examples/jsm/exporters/GLTFExporter.js\": \"sha384-VofkvpG6HERhFCYbsUOHeNXBCqID2nfqkQqnVzE1jc/oPcz+qJ13ADdXH08hE+cQ\"\n  }\n}\n<\u002Fscript>\n<script>window.addEventListener('error',e=>console.log('PAGEERR',e.message,e.filename,e.lineno));window.addEventListener('unhandledrejection',e=>console.log('REJ',e.reason&&e.reason.message||String(e.reason)));<\u002Fscript>\n<style>html,body{margin:0;height:100%}three-d-stage{width:100%;height:100%;display:block}three-d-stage:not(:defined){visibility:hidden}<\u002Fstyle>\n\n\n<\u002Fhead>\n<body>\n<three-d-stage name=\"willard-style-b\" background=\"#efece3\" autorotate=\"\"><\u002Fthree-d-stage>\n<script src=\"63e6ec88-2563-4ca3-9469-76e6c0b534d7\"><\u002Fscript>\n<script type=\"module\">\nconst stage = document.querySelector('three-d-stage');\nconst { THREE } = await stage.ready;\nconst IN = 0.0254;\n// Nympheus-style motif texture for the velvet channels\nconst tc = document.createElement('canvas'); tc.width = tc.height = 512;\nconst g2 = tc.getContext('2d');\ng2.fillStyle = '#0b5238'; g2.fillRect(0,0,512,512);\nfunction lily(x,y,s,rot){ g2.save(); g2.translate(x,y); g2.rotate(rot); g2.scale(s,s);\n  g2.fillStyle = '#2f8f63'; g2.beginPath(); g2.moveTo(0,0);\n  g2.arc(0,0,52,0.35,2*Math.PI-0.35); g2.closePath(); g2.fill();\n  g2.strokeStyle = 'rgba(7,58,40,.7)'; g2.lineWidth = 3;\n  for(let i=0;i<7;i++){ const a2=0.5+i*(2*Math.PI-1)/6; g2.beginPath(); g2.moveTo(0,0); g2.lineTo(46*Math.cos(a2),46*Math.sin(a2)); g2.stroke(); }\n  g2.strokeStyle = '#79c49a'; g2.lineWidth = 4; g2.beginPath();\n  g2.arc(0,0,52,0.35,2*Math.PI-0.35); g2.stroke();\n  g2.restore(); }\nlily(120,110,1.0,-0.5); lily(380,300,1.25,0.7); lily(150,400,0.8,2.4); lily(430,80,0.7,1.6);\nfunction bud(x,y,s){ g2.save(); g2.translate(x,y); g2.scale(s,s); g2.fillStyle = '#c9a15a';\n  for(const r of [-0.5,0,0.5]){ g2.save(); g2.rotate(r); g2.beginPath(); g2.moveTo(0,14); g2.quadraticCurveTo(-11,-2,0,-16); g2.quadraticCurveTo(11,-2,0,14); g2.fill(); g2.restore(); }\n  g2.restore(); }\nbud(300,150,1.1); bud(70,270,0.9); bud(260,440,1.0);\nconst motif = new THREE.CanvasTexture(tc);\nmotif.wrapS = motif.wrapT = THREE.RepeatWrapping; motif.repeat.set(2.5,2.5);\nmotif.colorSpace = THREE.SRGBColorSpace;\n// fringe strand texture — transparent gaps so it reads as hanging strings, not tape\nconst fc = document.createElement('canvas'); fc.width = 128; fc.height = 64;\nconst g3 = fc.getContext('2d');\nfor(let x=0;x<128;x+=3){ g3.strokeStyle = (x%6)? '#8a6428' : '#e2b76d';\n  const len = 50 + (x*7)%14; // ragged bottoms\n  g3.lineWidth = 2.1; g3.beginPath(); g3.moveTo(x+0.5,4); g3.lineTo(x+0.5+(x%5-2),len); g3.stroke(); }\n// solid header band along the top\ng3.fillStyle = '#8a6428'; g3.fillRect(0,0,128,7);\ng3.fillStyle = '#c9a15a'; g3.fillRect(0,7,128,2);\nconst strands = new THREE.CanvasTexture(fc);\nstrands.wrapS = strands.wrapT = THREE.RepeatWrapping; strands.repeat.set(60,1);\nstrands.colorSpace = THREE.SRGBColorSpace;\n\nconst velvetDk = new THREE.MeshStandardMaterial({name:'velvet_reveal', color:0x05231a, roughness:1.0});\nconst velvet  = new THREE.MeshStandardMaterial({name:'velvet_emerald', map:motif, roughness:0.92});\n// real Nympheus Emerald scan — swaps in over the placeholder motif when loaded\nconst texLoader = new THREE.TextureLoader(); texLoader.setCrossOrigin('anonymous');\n// client-provided Nympheus scan — true scale: one 35.46\" repeat ≈ 0.9 m\ntexLoader.load(window.__resources.nympheusScan, t=>{\n  t.colorSpace = THREE.SRGBColorSpace;\n  t.wrapS = t.wrapT = THREE.RepeatWrapping;\n  t.repeat.set(1.11,1.11);\n  t.offset.x = 0.5; // repeat centered on CL, seams fall mid-panel\n  t.offset.y = 0.15; // drop the motif so flowers sit clear of the rail\n  velvet.map = t; velvet.needsUpdate = true;\n});\nconst vinyl   = new THREE.MeshStandardMaterial({name:'vinyl_ale',      color:0x96683a, roughness:0.45, metalness:0.05});\nconst vinylL  = new THREE.MeshStandardMaterial({name:'vinyl_ale_lt',   color:0xa97a45, roughness:0.5});\nconst fringe  = new THREE.MeshStandardMaterial({name:'fringe_rupi',    map:strands, roughness:1.0, transparent:true, alphaTest:0.4, side:THREE.DoubleSide});\nconst muslin  = new THREE.MeshStandardMaterial({name:'muslin_unfinished', color:0xded2b8, roughness:1.0});\n// annular sector, y-up, optional soft bevel on top/bottom edges\nfunction sector(r0,r1,t0,t1,y0,y1,mat,name,bev=0,segs=48){\n  const sh = new THREE.Shape();\n  sh.absarc(0,0,r1,Math.PI/2-t1,Math.PI/2-t0,false);\n  sh.absarc(0,0,r0,Math.PI/2-t0,Math.PI/2-t1,true);\n  const opt = {depth:(y1-y0),bevelEnabled:bev>0,curveSegments:segs};\n  if(bev>0){opt.bevelThickness=bev;opt.bevelSize=bev*0.8;opt.bevelSegments=3;}\n  const geo = new THREE.ExtrudeGeometry(sh,opt);\n  geo.rotateX(-Math.PI/2);\n  const m = new THREE.Mesh(geo,mat); m.position.y=y0+(bev>0?bev:0); m.name=name;\n  return m;\n}\n// revolve a side profile (r,h pts) around Y over sector [a,b], with end caps\nfunction revolve(pts,a,b,mat,name,segs=48){\n  const m2 = mat.clone(); m2.side = THREE.DoubleSide;\n  const g = new THREE.Group(); g.name = name;\n  const v2 = pts.map(p=>new THREE.Vector2(p[0],p[1]));\n  const lat = new THREE.LatheGeometry(v2.concat([v2[0].clone()]), segs, Math.PI-b, b-a);\n  g.add(new THREE.Mesh(lat,m2));\n  const sh = new THREE.Shape(v2);\n  for(const t of [a,b]){\n    const cap = new THREE.Mesh(new THREE.ShapeGeometry(sh), m2);\n    const u = new THREE.Vector3(Math.sin(t),0,-Math.cos(t));\n    cap.matrix.makeBasis(u,new THREE.Vector3(0,1,0),new THREE.Vector3().crossVectors(u,new THREE.Vector3(0,1,0)));\n    cap.matrix.decompose(cap.position,cap.quaternion,cap.scale);\n    g.add(cap);\n  }\n  return g;\n}\nconst G = new THREE.Group(); G.name='willard_style_b';\nconst thL=-0.348, thR=0.348;\nconst R=r=>r*IN, H=z=>z*IN, B=x=>x*IN;\n// Depth: front face R94 · 24\" clear seat · channels 36\" (one repeat) at 102° · 1\" top rail · rear plumb at R128.7 → crown 55\"\nconst LEAN = 7.7/36; // channel lean slope dR/dH\nconst innerAt = h => 121 + LEAN*(h-18); // channel back face radius\nconst REAR = 128.7; // plumb rear face, flush with back of top rail\nlet ci=0;\n// one-piece banquette: soft parts inset slightly so the flat side walls read as a single plane\nfor (const [a,b,tag] of [[thL+0.012,thR-0.012,'u1']]){\n  const U = new THREE.Group(); U.name='banquette'; G.add(U);\n  const add = m=>U.add(m);\n  // vinyl base: stops at back slab inner face\n  add(sector(R(94),R(117.5),a,b,H(1),H(12.4),vinyl,'base_'+tag,B(0.9)));\n  // seat cushion: 5\" thick, top 18\" AFF, 24\" clear depth, bullnosed\n  add(sector(R(94.3),R(117.5),a,b,H(13.8),H(16.4),vinylL,'cushion_'+tag,B(1.3)));\n  // back of bench: single 1\" thick plumb slab, floor to crown — channels sit against it\n  add(revolve([[R(127.7),H(1)],[R(127.7),H(55)],[R(REAR),H(55)],[R(REAR),H(1)]], a,b,vinyl,'back_slab_'+tag));\n  const ca=a+0.016, cb=b-0.016, d4=(cb-ca)/8;\n  // (channel boundaries darkened by leaned reveal strips below)\n  // flat velvet channel panels at 102° (12° lean), soft crowns, motif\n  for(let k=0;k<8;k++){\n    const t1=ca+d4*k+0.007, t2=ca+d4*(k+1)-0.007, tc=(t1+t2)/2;\n    const w=(t2-t1)*R(117);\n    const prof=new THREE.Shape();\n    prof.moveTo(R(117.6),H(16.2)); prof.lineTo(R(120.6),H(16.2));\n    prof.lineTo(R(126.7),H(54.4)); prof.lineTo(R(125.2),H(54.4));\n    prof.lineTo(R(117.6),H(16.2));\n    const geo=new THREE.ExtrudeGeometry(prof,{depth:w,bevelEnabled:true,bevelThickness:B(0.8),bevelSize:B(0.7),bevelSegments:3});\n    const u=new THREE.Vector3(Math.sin(tc),0,-Math.cos(tc));\n    const tg=new THREE.Vector3(Math.cos(tc),0,Math.sin(tc));\n    const m=new THREE.Mesh(geo,velvet); m.name='channel_'+(++ci);\n    m.matrix.makeBasis(u,new THREE.Vector3(0,1,0),tg);\n    m.matrix.setPosition(tg.clone().multiplyScalar(-w/2));\n    // cylindrical world-space UVs — the motif runs unbroken across all 8 channels\n    {const pos=geo.attributes.position, uvA=geo.attributes.uv, p3=new THREE.Vector3();\n     for(let i2=0;i2<pos.count;i2++){ p3.fromBufferAttribute(pos,i2).applyMatrix4(m.matrix);\n       uvA.setXY(i2, Math.atan2(p3.x,-p3.z)*3.05, p3.y); } uvA.needsUpdate=true;}\n    m.matrix.decompose(m.position,m.quaternion,m.scale);\n    U.add(m);\n  }\n  // leaned dark reveal strips at channel boundaries\n  for(let k=1;k<8;k++){\n    const tb=ca+d4*k, w2=0.016*R(117);\n    const prof2=new THREE.Shape();\n    prof2.moveTo(R(118.4),H(16.2)); prof2.lineTo(R(120.8),H(16.2));\n    prof2.lineTo(R(126.8),H(54.3)); prof2.lineTo(R(126.0),H(54.3));\n    prof2.lineTo(R(118.4),H(16.2));\n    const geo2=new THREE.ExtrudeGeometry(prof2,{depth:w2,bevelEnabled:false});\n    const u2=new THREE.Vector3(Math.sin(tb),0,-Math.cos(tb));\n    const tg2=new THREE.Vector3(Math.cos(tb),0,Math.sin(tb));\n    const m2=new THREE.Mesh(geo2,velvetDk); m2.name='reveal_'+tag+'_'+k;\n    m2.matrix.makeBasis(u2,new THREE.Vector3(0,1,0),tg2);\n    m2.matrix.setPosition(tg2.clone().multiplyScalar(-w2/2));\n    m2.matrix.decompose(m2.position,m2.quaternion,m2.scale);\n    U.add(m2);\n  }\n  // (top rail eliminated — channel crowns are the top of the bench)\n  // fringe skirt — front face only, hanging strands between the arms\n  U.add(sector(R(92.7),R(92.95),thL+0.033,thR-0.033,H(0.6),H(7),fringe,'fringe_front',B(0.05)));\n}\n// end panels: arm + side as ONE element per end — single flat plane, all vinyl, floor to crown\nfor(const [t,dir,nm] of [[thL,1,'end_left'],[thR,-1,'end_right']]){\n  const p=new THREE.Shape();\n  p.moveTo(R(93),H(1)); p.lineTo(R(93),H(22.8));\n  p.quadraticCurveTo(R(93),H(24),R(95),H(24));\n  p.lineTo(R(116),H(24));\n  p.quadraticCurveTo(R(119.5),H(24),R(120.6),H(31.5));\n  p.lineTo(R(123.9),H(50.2));\n  p.quadraticCurveTo(R(124.9),H(55),R(126.6),H(55));\n  p.lineTo(R(128.7),H(55));\n  p.lineTo(R(128.7),H(1));\n  p.lineTo(R(93),H(1));\n  const geo=new THREE.ExtrudeGeometry(p,{depth:B(3),bevelEnabled:false});\n  const u=new THREE.Vector3(Math.sin(t),0,-Math.cos(t));\n  const tg=new THREE.Vector3(Math.cos(t),0,Math.sin(t)).multiplyScalar(dir);\n  const m=new THREE.Mesh(geo,vinylL); m.name=nm;\n  m.matrix.makeBasis(u,new THREE.Vector3(0,1,0),tg);\n  m.matrix.decompose(m.position,m.quaternion,m.scale);\n  G.add(m);\n}\n// (side walls folded into the one-piece end panels above)\nconst box = new THREE.Box3().setFromObject(G);\nconst c = box.getCenter(new THREE.Vector3());\nG.position.set(-c.x, -box.min.y, -c.z);\nconst root = new THREE.Group(); root.name='root'; root.add(G);\nstage.setObject(root);\nroot.traverse(o=>{ if(o.material===fringe){ o.castShadow=false; o.receiveShadow=false; } if(/^(cushion|base)/.test(o.name)){ o.receiveShadow=false; } });\n// deterministic capture hook\nwindow.__setView = (deg) => { root.rotation.y = deg*Math.PI/180; };\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
